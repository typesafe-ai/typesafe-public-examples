    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "jev-1.13.0"
        },
        "stateFormat": "text",
        "stateText": "={{ $json.message }}",
        "questions": {
          "question": [
            {
              "type": "choice",
              "id": "topic",
              "instructions": "What is the message about?",
              "choiceOptions": {
                "option": [
                  {
                    "name": "cards",
                    "description": "Debit and credit cards: lost, stolen, blocked, declined, or new."
                  },
                  {
                    "name": "payments",
                    "description": "Transfers, direct debits, and payments in or out."
                  },
                  {
                    "name": "account",
                    "description": "Logging in, personal details, statements, and account settings."
                  }
                ]
              }
            },
            {
              "type": "noul",
              "id": "fraud",
              "instructions": "Does the customer report that someone else used their account or card?",
              "trueMeans": "The customer says someone else used their account or card.",
              "falseMeans": "The customer does not report use by someone else."
            },
            {
              "type": "score",
              "id": "urgency",
              "instructions": "How soon does the bank need to act?",
              "scoreLevels": {
                "level": [
                  {
                    "level": "It can wait a few days."
                  },
                  {
                    "level": "It should be handled today."
                  },
                  {
                    "level": "Money is at risk until someone acts."
                  }
                ]
              }
            }
          ]
        },
        "options": {}
      },
      "name": "Triage",
      "type": "@typesafe-ai/n8n-nodes-typesafe-ai.typeSafeAi",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "fraud-threshold",
              "leftValue": "={{ $json.answers.fraud.noul }}",
              "rightValue": 0.3,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Fraud?",
